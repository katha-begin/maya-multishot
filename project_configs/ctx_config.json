{
  "version": "1.0",
  "project": {
    "name": "SWA",
    "code": "SWA",
    "description": "Sample project configuration for Context Variables Pipeline"
  },
  "roots": {
    "windows": {
      "projRoot": "V:/",
      "imgRoot": "W:/"
    },
    "linux": {
      "projRoot": "/mnt/igloo_swa_v/",
      "imgRoot": "/mnt/igloo_swa_w/"
    }
  },
  "staticPaths": {
    "sceneBase": "all/scene",
    "assetBase": "all/asset"
  },
  "deptPriority": {
    "description": "Department resolution priority — index 0 wins when the same asset exists in multiple departments. Higher index = lower priority.",
    "order": ["lighting", "fx", "cfx", "anim", "layout"]
  },
  "templates": {
    "shotRoot": "$projRoot$project/$sceneBase/$ep/$seq/$shot",
    "shotWork": "$projRoot$project/$sceneBase/$ep/$seq/$shot/$dept/version",
    "publishPath": "$projRoot$project/$sceneBase/$ep/$seq/$shot/$dept/publish",
    "cachePath": "$projRoot$project/$sceneBase/$ep/$seq/$shot/$dept/publish/$ver",
    "imgPath": "$imgRoot$project/$sceneBase/$ep/$seq/$shot/$dept/publish/$ver/<RenderLayer>/<RenderLayer>",
    "assetPath": "$projRoot$project/$sceneBase/$ep/$seq/$shot/$dept/publish/$ver/$ep_$seq_$shot__$assetType_$assetName_$variant.$ext",
    "assetHeroPath": "$projRoot$project/$assetBase/$assetCategory/$assetSubdir/$assetName/$heroSubdir/$assetName.$ext",
    "assetShaderPath": "$projRoot$project/$assetBase/$assetCategory/$assetSubdir/$assetName/$heroSubdir/$assetName$shaderSuffix",
    "assetGroomPath": "$projRoot$project/$assetBase/$assetCategory/$assetSubdir/$assetName/$heroSubdir/$assetName$groomSuffix",
    "assetSearchPath": "$projRoot$project/$assetBase/$assetCategory/$assetSubdir/$assetName/$heroSubdir",
    "fullFilename": "$ep_$seq_$shot__$assetType_$assetName_$variant.$ext",
    "namespace": "$assetType_$assetName_$variant",
    "namespaceShader": "$assetType_$assetName_$variant_Shade",
    "namespaceGroom": "$assetType_$assetName_$variant_Groom"
  },
  "assetDiscovery": {
    "heroSubdir": "hero",
    "cameraFileSuffix": "_camera",
    "texRenderSubdir": "tex_render",
    "shaderFileSuffix": "_rsshade.ma",
    "groomFileSuffix": "_groom.ma",
    "categoryMappings": {
      "CHAR": {
        "directory": "Character",
        "subdirs": ["Main", "Extra"]
      },
      "PROP": {
        "directory": "Props",
        "subdirs": ["object"]
      },
      "SETS": {
        "directory": "Sets",
        "subdirs": ["exterior", "interior"]
      },
      "SDRS": {
        "directory": "Setdress",
        "subdirs": ["interior", "exterior", "Set"]
      }
    }
  },
  "gafferAttributes": {
    "simple": [
      "intensity", "exposure", "spread", "muted",
      "affectDiffuse", "affectSpecular", "affectGI", "shadowEnable"
    ],
    "compound": {
      "color":     ["colorR",    "colorG",    "colorB"],
      "translate": ["translateX","translateY","translateZ"],
      "rotate":    ["rotateX",   "rotateY",   "rotateZ"],
      "scale":     ["scaleX",    "scaleY",    "scaleZ"]
    }
  },
  "patterns": {
    "fullFormat": "$ep_$seq_$shot__$assetType_$assetName_$variant.$ext",
    "namespaceFormat": "$assetType_$assetName_$variant",
    "shotContext": "$ep_$seq_$shot",
    "version": "v###"
  },
  "extensions": [
    ".abc",
    ".vdb",
    ".ass",
    ".rs",
    ".ma",
    ".mb"
  ],
  "tokens": {
    "ep": {
      "description": "Episode code",
      "example": "Ep04",
      "pattern": "Ep\\d+"
    },
    "seq": {
      "description": "Sequence code",
      "example": "sq0070",
      "pattern": "sq\\d+"
    },
    "shot": {
      "description": "Shot code",
      "example": "SH0170",
      "pattern": "SH\\d+"
    },
    "dept": {
      "description": "Department",
      "example": "anim",
      "values": ["layout", "anim", "cfx", "fx", "lighting"]
    },
    "ver": {
      "description": "Version",
      "example": "v003",
      "pattern": "v\\d{3}"
    },
    "assetType": {
      "description": "Asset type code",
      "example": "CHAR",
      "values": ["CHAR", "PROP", "SETS", "SDRS", "VEH", "CAM"]
    },
    "assetCategory": {
      "description": "Asset category directory name",
      "example": "Character",
      "values": ["Character", "Props", "Sets", "Setdress", "Vehicle"],
      "mapping": {
        "CHAR": "Character",
        "PROP": "Props",
        "SETS": "Sets",
        "SDRS": "Setdress",
        "VEH": "Vehicle"
      }
    },
    "assetSubdir": {
      "description": "Asset subdirectory (Main, object, Exterior, etc.)",
      "example": "Main",
      "values": ["Main", "object", "Exterior", "Interior", "interior", "exterior"]
    },
    "assetName": {
      "description": "Asset name",
      "example": "CatStompie"
    },
    "variant": {
      "description": "Asset variant",
      "example": "001",
      "pattern": "\\d{3}"
    },
    "heroSubdir": {
      "description": "Hero subdirectory for asset files",
      "example": "hero",
      "default": "hero"
    },
    "shaderSuffix": {
      "description": "Shader file suffix",
      "example": "_rsshade.ma",
      "default": "_rsshade.ma"
    },
    "groomSuffix": {
      "description": "Groom file suffix",
      "example": "_groom.ma",
      "default": "_groom.ma"
    }
  },
  "renderers": {
    "redshift": {
      "standinExtension": "rs",
      "standinNodeType": "RedshiftProxyMesh",
      "standinFileAttr": "fileName",
      "preferredExtensions": ["rs", "abc", "ma", "mb"]
    },
    "arnold": {
      "standinExtension": "ass",
      "standinNodeType": "aiStandIn",
      "standinFileAttr": "dso",
      "preferredExtensions": ["ass", "abc", "ma", "mb"]
    },
    "maya": {
      "standinExtension": null,
      "standinNodeType": null,
      "standinFileAttr": null,
      "preferredExtensions": ["ma", "mb", "abc"]
    }
  },
  "renderSettings": {
    "enabled": true,
    "outputPath": {
      "template": "imgPath",
      "deptSource": "sceneFile",
      "deptFallback": "lighting",
      "versionSource": "sceneFile",
      "versionFallback": "v001",
      "sceneFilePattern": "{ep}_{seq}_{shot}_{dept}_{variant}_{ver}.ma"
    },
    "camera": {
      "autoSetFromShot": true,
      "assetType": "CAM"
    }
  },
  "cache": {
    "lastUpdated": null,
    "episodes": [],
    "sequences": {},
    "shots": {},
    "departments": {},
    "assets": {
      "CHAR": [],
      "PROP": [],
      "SET": [],
      "VEH": []
    },
    "versions": {}
  },
  "logging": {
    "level": "INFO",
    "file": null,
    "verbose": false
  },
  "shotMetadata": {
    "enabled": true,
    "filenamePattern": ".{shot_id}.json",
    "location": "shotRoot",
    "fieldMapping": {
      "frameRange": {
        "jsonField": "shot_info",
        "parseFormat": "nested",
        "startField": "start_frame",
        "endField": "end_frame",
        "defaultStart": 1001,
        "defaultEnd": 1100
      },
      "fps": {
        "jsonField": "fps",
        "default": 25.0
      }
    }
  }
}

